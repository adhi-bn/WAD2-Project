# Copy to supabase/.env and fill in. These are SECRET. Never put them in the website's .env.
# Load them into Supabase with:
#   supabase secrets set --env-file ./supabase/.env
# The functions read these at runtime. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set by Supabase itself.

# HitPay (sandbox keys while testing)
HITPAY_API_KEY=YOUR-HITPAY-SANDBOX-API-KEY
HITPAY_SALT=YOUR-HITPAY-SALT
HITPAY_BASE=https://api.sandbox.hit-pay.com

# Sites allowed to receive customers back after payment (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# The service role key is NOT listed here. The CLI refuses secret names starting with SUPABASE_.
# Keep it in your shell only when running supabase/data.js (import), e.g.
#   SUPABASE_SERVICE_ROLE_KEY=... node supabase/import-run.js
# The deployed functions get it automatically from Supabase.

# Biscuit's advisor (TokenRouter OpenAI-compatible endpoint, server only)
TOKENROUTER_API_KEY=YOUR-TOKENROUTER-API-KEY
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=z-ai/glm-5.3-flash

# OneMap store locator (server only; use your registered OneMap account)
ONEMAP_EMAIL=YOUR-ONEMAP-ACCOUNT-EMAIL
ONEMAP_PASSWORD=YOUR-ONEMAP-ACCOUNT-PASSWORD
